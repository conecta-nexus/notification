# ==============================================================================
# Conecta Nexus - Notification Microservice Environment Configuration
# ==============================================================================

# Database connection URL (PostgreSQL with asyncpg driver)
# Container network default: postgres:5432
# Local host default: localhost:5432
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/db_notifications

# Database query logging
DB_ECHO=false

# Application Environment (development, testing, production)
APP_ENV=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Cryptographic Public Key for RS256 JWT Verification (ADR-002)
JWT_PUBLIC_KEY_PATH=certs/jwt_public.pem
