# ==============================================================================
# Conecta Nexus - Notification Microservice Environment Configuration
# ==============================================================================

# Database connection URL (PostgreSQL with asyncpg driver)
# Container network default: postgres:5432
# Local host default: localhost:5432
DATABASE_URL=

# Database query logging
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_HEALTH_TIMEOUT=2

# Application Environment (development, testing, production)
APP_ENV=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Cryptographic Public Key for RS256 JWT Verification (ADR-002)
JWT_PUBLIC_KEY_PATH=certs/jwt_public.pem
JWT_ISSUER=https://auth.conectanexus.ufps.edu.co
JWT_AUDIENCES=["conecta-nexus-gateway","conecta-nexus-services"]
# Optional, public PEM only. When supplied, it takes precedence over the path.
JWT_PUBLIC_KEY=

# Proposed internal listener credentials. Keep unset until provisioned.
APPLICATION_EVENT_SECRET=
CHALLENGE_EVENT_SECRET=
